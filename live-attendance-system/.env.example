# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development

# macOS uses port 5000 for AirPlay Receiver, so this project defaults to 5001.
PORT=5001

# Local: mongodb://127.0.0.1:27017/live-attendance
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/live-attendance?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/live-attendance

# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed to call this API. Comma-separated, no trailing slash.
CLIENT_URL=http://localhost:5173

# Minutes after a session starts before a student is recorded as "late".
LATE_AFTER_MINUTES=10

# bcrypt cost factor. 12 is a good default; lower only for tests.
BCRYPT_ROUNDS=12
